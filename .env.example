
# ──────────────────────────────────────────────────────────────────────────────
# Docker + Caddy TLS 자동화 설정 (docker-compose.waf.yml)
# ──────────────────────────────────────────────────────────────────────────────
# Let's Encrypt 인증서 알림 이메일 (필수 — 실제 이메일 입력)
# ACME_EMAIL=you@example.com

# Caddyfile 경로 (기본: 프로덕션 on-demand TLS)
# CADDY_CONFIG=infra/Caddyfile
# 로컬 개발용 자체서명 TLS:
# CADDY_CONFIG=infra/Caddyfile.dev

# WAF 스택 실행 명령:
#   프로덕션:  ACME_EMAIL=you@example.com docker compose -f docker-compose.waf.yml up -d
#   로컬 개발: CADDY_CONFIG=infra/Caddyfile.dev docker compose -f docker-compose.waf.yml up -d
#   Juice Shop 포함: docker compose -f docker-compose.waf.yml --profile demo up -d
#
# 도메인 연결 절차:
#   1) DNS A 레코드: yourdomain.com -> 서버 공인 IP
#   2) 대시보드 사이트 관리에서 도메인 등록
#   3) 브라우저로 https://yourdomain.com 접속 → Caddy가 자동으로 cert 발급

# 두 번째 프록시 전용(첫 번째와 .env SITE_ID가 겹치지 않게)
# SITE_ID_SECOND=other_app
# UPSTREAM_URL_SECOND=http://127.0.0.1:3002

# ──────────────────────────────────────────────────────────────────────────────
# WAF 프록시 워커 설정 (main.py)
# 사이트마다 별도 터미널에서 다른 SITE_ID / UPSTREAM_URL / 포트로 실행합니다.
# ──────────────────────────────────────────────────────────────────────────────

# 이 프록시가 담당하는 사이트 식별자 (중앙 대시보드에서 구분에 사용)
SITE_ID=juiceshop

# 업스트림 웹 앱 베이스 URL (Juice Shop, DVWA, 자체 앱 등)
UPSTREAM_URL=http://127.0.0.1:3001
# 다른 호스트/포트 예: http://192.168.0.20:3001  https://internal.example.com

# 중앙 대시보드 연결(다른 서버에 센서를 설치할 때 사용)
# 대시보드 설정 화면에서 계정별 SITE_ID / SENSOR_TOKEN 값을 확인해 넣습니다.
#
# 【로컬 자동 ingest】 CENTRAL 과 SENSOR 가 비어 있으면 프록시는 기본적으로
#   http://127.0.0.1:8080 + waf_auth 의 admin 의 sensor_token 으로 POST 합니다 (같은 PC에서 make 대시보드 등).
#   끄려면 WAF_DISABLE_DEFAULT_CENTRAL_INGEST=true
# 다른 포트 호스트명으로 보내야 하면: WAF_FALLBACK_CENTRAL_URL=http://192.168.x.x:8080
#
# CENTRAL_DASHBOARD_URL=http://192.168.100.155:8080
# SENSOR_TOKEN=<대시보드 설정 화면의 sensor_ 토큰 — admin 또는 해당 사이트 일반 사용자>
# 관리자 토큰: 프록시 SITE_ID 라벨을 그대로 중앙 DB에 적재. 일반 사용자 토큰: 회원가입 site_id 와 반드시 일치해야 ingest 성공.

# WAF: 요청 스캔 후 심각도가 이 값 이상이면 403 (none|low|medium|high|critical)
WAF_BLOCK_MIN_SEVERITY=high
# WAF 끄기(프록시만): WAF_ENABLED=false
# WAF_ENABLED=true
#
# 중앙 대시보드에 저장된 【사이트별 WAF On/Off】 를 워커가 따릅니다 (CENTRAL+SENSOR ingest 가 잡힐 때).
# 끄려면: WAF_FOLLOW_SITE_POLICY=false  (로컬 테스트에서만 권장)
# 정책 조회 캐시(초): WAF_SITE_POLICY_CACHE_SEC=3
# 본문 프리뷰 최대 바이트 (모듈에 넘기는 크기)
# WAF_BODY_PREVIEW_MAX=8192

# ──────────────────────────────────────────────────────────────────────────────
# AI 2차 탐지/차단 (무료 로컬 Ollama 모델)
# ──────────────────────────────────────────────────────────────────────────────
# 룰 기반 1차 탐지 후, 차단 후보는 없지만 의심스러운 요청을 로컬 LLM으로 재판정합니다.
# Ollama 실행 후 활성화하세요. 모델 미실행/타임아웃이면 기존 룰 정책으로 안전하게 동작합니다.
# AI_SECOND_PASS_ENABLED=false
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=qwen2.5:7b-instruct
# AI_BLOCK_MIN_CONFIDENCE=0.75
# AI_SECOND_PASS_TIMEOUT_SEC=3.0
# AI_SECOND_PASS_MODE=suspicious   # suspicious|always
# AI_SECOND_PASS_BODY_MAX_CHARS=1600
# AI 상태 확인:
#   프록시 health: http://127.0.0.1:8081/__proxy/health  의 ai_second_pass
#   워커 콘솔:    http://127.0.0.1:8081/__waf/worker/logs
#   워커 API:     GET /__waf/worker/api/ai-status (관리자 세션 필요)

# ──────────────────────────────────────────────────────────────────────────────
# 중앙 대시보드 인증 설정
# ──────────────────────────────────────────────────────────────────────────────
# 세션 서명 키 — 운영 환경에서 반드시 긴 무작위 문자열로 변경할 것
WAF_SECRET_KEY=change-me-to-a-long-random-string

# 공개 회원가입 (/register). 운영에서 닫으려면 false
# WAF_ALLOW_REGISTRATION=false
# WAF_ALLOW_REGISTRATION=true

# 로컬 데모용 admin/jimin 자동 생성. 공개 서비스는 false 권장(직접 admin 생성 또는 회원가입만)
# WAF_SEED_DEFAULT_USERS=false
# WAF_SEED_DEFAULT_USERS=true

# 기본 계정 (WAF_SEED_DEFAULT_USERS=true 이고 최초 DB일 때만 생성)
#   admin / admin  → 관리자 (모든 사이트 조회)
#   jimin / jimin  → 일반 (juiceshop 사이트만)

# ──────────────────────────────────────────────────────────────────────────────
# 무료 배포 시 DB (요약)
# ──────────────────────────────────────────────────────────────────────────────
# 이 프로젝트는 기본으로 SQLite 파일 두 개를 씁니다(트래픽: TRAFFIC_LOG_DB, 계정: waf_auth.sqlite3).
#
# - Render/Fly 등: 영속 디스크(볼륨)를 쓰거나, 같은 프로젝트 폴더에 두 파일이 유지되게 설정.
# - Neon / Supabase(무료 Postgres)·Turso(무료 SQLite 호환) 등으로 옮기려면 별도 어댑터 작업이 필요함.
# - 당장은 대시보드 + 모든 프록시가 같은 머신/같은 디스크를 보도록 두는 것이 가장 단순함.
#
# 다른 서버의 사용자: 회원가입으로 본인 site_id 를 받고, 그 서버의 프록시에 SITE_ID=동일 값 설정.

# ──────────────────────────────────────────────────────────────────────────────
# 공유 SQLite (중앙 대시보드와 모든 프록시가 동일 경로를 써야 함)
# ──────────────────────────────────────────────────────────────────────────────
# TRAFFIC_LOG_DB=/절대/경로/waf_traffic.sqlite3   # 기본: 프로젝트 루트의 waf_traffic.sqlite3
# TRAFFIC_LOG_MAX_ROWS=10000
# TRAFFIC_LOG_SNAPSHOT_LIMIT=500

# 프록시가 HTML/JS/JSON 안의 업스트림 절대 URL을 클라이언트 origin으로 치환하는 최대 크기
# PROXY_REWRITE_MAX_BYTES=6291456

# ──────────────────────────────────────────────────────────────────────────────
# 실행 명령 (3개 터미널)
# ──────────────────────────────────────────────────────────────────────────────
#
# [터미널 1] 중앙 대시보드 — LAN의 모든 기기가 이 주소로 대시보드를 봄
#   python3 -m uvicorn dashboard_app:app --host 0.0.0.0 --port 8080 --reload
#   → http://192.168.100.155:8080/__waf/dashboard
#
# [터미널 2] WAF 프록시 — Juice Shop
#   SITE_ID=juiceshop UPSTREAM_URL=http://127.0.0.1:3001 \
#     python3 -m uvicorn main:app --host 0.0.0.0 --port 8081 --reload
#   → http://192.168.100.155:8081/   (Juice Shop 을 이 URL로 공격)
#   → 이 프록시의 SQLite 로컬 로그만 보려면(차단·통과): http://192.168.100.155:8081/__waf/worker/logs
#      (중앙 대시보드와 동일 admin 계정, root / 는 업스트림이라 로그 UI 는 여기 경로 사용)
#
# [터미널 3] WAF 프록시 — 두 번째 앱
#   SITE_ID=other_app UPSTREAM_URL=http://127.0.0.1:3002 \
#     python3 -m uvicorn main:app --host 0.0.0.0 --port 8082 --reload
#   → http://192.168.100.155:8082/
#
# ※ LAN IP 확인: ipconfig getifaddr en0
# ※ Juice Shop Docker: docker run -d -p 3001:3000 bkimminich/juice-shop
