# Caddyfile (Production) — OWASP WAF Multi-site TLS
# ============================================================
# 사전 조건:
#   - 각 보호 도메인의 A/AAAA 레코드가 이 서버 IP를 가리킬 것
#   - ACME_EMAIL 환경변수 설정 (docker-compose.waf.yml 참고)
#
# 동작:
#   1) :80  -> HTTPS 리다이렉트
#   2) :443 -> On-demand TLS (Let's Encrypt, 최초 요청 시 자동 발급)
#              Host 헤더를 그대로 WAF(포트 8000)로 전달
#
# On-demand TLS 검증:
#   Caddy가 cert 발급 전 /__waf/api/tls-check?domain=<도메인> 으로 확인.
#   WAF에 등록된 도메인이면 200 OK -> cert 발급 진행, 미등록이면 403 -> 거부.
# ============================================================

{
    email {$ACME_EMAIL:admin@example.com}

    on_demand_tls {
        ask      http://waf:8000/__waf/api/tls-check
        interval 2m
        burst    5
    }
}

# HTTP -> HTTPS 강제 리다이렉트
:80 {
    redir https://{host}{uri} permanent
}

# HTTPS catch-all: 모든 도메인 -> WAF
:443 {
    tls {
        on_demand
    }

    reverse_proxy waf:8000 {
        header_up Host              {host}
        header_up X-Real-IP         {remote_host}
        header_up X-Forwarded-For   {remote_host}
        header_up X-Forwarded-Proto {scheme}

        health_uri      /__proxy/health
        health_interval 10s
        health_timeout  5s

        transport http {
            dial_timeout            5s
            response_header_timeout 60s
        }
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size     50MiB
            roll_keep     5
            roll_keep_for 720h
        }
        format json
    }
}
